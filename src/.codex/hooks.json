{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.vibegame/hooks/session-start.py\" --source-app codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.vibegame/hooks/web_hook.py\" --source-app codex --event-type SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.vibegame/hooks/web_hook.py\" --source-app codex --event-type PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.vibegame/hooks/goal-capture.py\" --source-app codex",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.vibegame/hooks/user-prompt-submit.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.vibegame/hooks/web_hook.py\" --source-app codex --event-type UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.vibegame/hooks/agent-team-stop.py\" --source-app codex",
            "timeout": 360
          }
        ]
      }
    ]
  }
}
